# Spark configuration
SPARK_APP_NAME=PagilaSparkTasks
SPARK_MASTER=local[2]
SPARK_LOCAL_IP=127.0.0.1
SPARK_LOCAL_HOSTNAME=localhost
SPARK_DRIVER_HOST=127.0.0.1
SPARK_DRIVER_BIND_ADDRESS=127.0.0.1

# PostgreSQL configuration
PAGILA_DB_URL=jdbc:postgresql://127.0.0.1:55432/pagila
PAGILA_DB_USER=postgres
PAGILA_DB_PASSWORD=CHANGE_ME

# JDBC driver
POSTGRES_JDBC_JAR=postgresql-42.7.14.jar
  
